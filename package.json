{
  "name": "rexmessages",
  "productName": "RexMessages",
  "version": "0.1.4",
  "description": "Google Messages for web wrapped as a Windows app with quick-reply popups and a photo gallery",
  "author": "Rex",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:icons": "node scripts/build-icons.mjs",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reptar-rex-u/RexMessages.git"
  },
  "build": {
    "appId": "com.rex.rexmessages",
    "productName": "RexMessages",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*.png",
          "**/*.ico"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "reptar-rex-u",
        "repo": "RexMessages",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RexMessages",
      "deleteAppDataOnUninstall": false,
      "artifactName": "RexMessages-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
